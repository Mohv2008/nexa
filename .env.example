# Browser-visible values (never put secrets in PUBLIC_* values)
PUBLIC_API_URL=http://localhost:8787/v1
PUBLIC_WEB_URL=http://localhost:5173
PUBLIC_RELEASE_URL=https://github.com/your-org/nexa/releases/latest
PUBLIC_WINDOWS_DOWNLOAD_URL=https://github.com/your-org/nexa/releases/latest
PUBLIC_ANDROID_DOWNLOAD_URL=https://github.com/your-org/nexa/releases/latest

# Copy the server values to backend/.dev.vars for local Wrangler development.
# Generate each with: openssl rand -base64 32
JWT_SECRET=replace-with-at-least-32-random-bytes
DATA_ENCRYPTION_KEY=replace-with-a-base64-encoded-32-byte-key
INTERNAL_SECRET=replace-with-at-least-32-random-bytes
ALLOWED_ORIGINS=http://localhost:5173,tauri://localhost,https://tauri.localhost
RESEND_API_KEY=
EMAIL_FROM=NEXA <noreply@example.com>
HIBP_ENABLED=true
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# GitHub Actions release secrets (configure in repository settings, never here)
# CLOUDFLARE_API_TOKEN, CLOUDFLARE_ACCOUNT_ID
# ANDROID_KEYSTORE_BASE64, ANDROID_KEYSTORE_PASSWORD, ANDROID_KEY_ALIAS
# ANDROID_KEY_PASSWORD, TAURI_SIGNING_PRIVATE_KEY, TAURI_SIGNING_PRIVATE_KEY_PASSWORD
